import java.util.Scanner;

public class PraktikumPerulangan {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Masukkan 2 digit terakhir NIM: ");
        int n = input.nextInt();

        // Jika n < 10, tambahkan 10
        if (n < 10) {
            n += 10;
        }

        for (int i = 1; i <= n; i++) {

            // Angka 10 dan 15 tidak dicetak
            if (i == 10 || i == 15) {
                continue;
            }

            // Kelipatan 3
            if (i % 3 == 0) {
                System.out.print("# ");
            }
            // Bilangan genap selain kelipatan 3
            else if (i % 2 == 0) {
                System.out.print(i + " ");
            }
            // Bilangan ganjil
            else {
                System.out.print("* ");
            }
        }

        input.close();
    }
}
